<%@ Page Title="" Language="C#" MasterPageFile="~/MasterPages/Site.Master" AutoEventWireup="true" CodeBehind="About.aspx.cs" Inherits="JanVoice.About" %>
<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="server">
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">

    <!--==================================
        ABOUT HERO SECTION
===================================-->

<section class="about-hero">

    <div class="container">

        <div class="about-hero-content">

            <!-- Left Side -->

            <div class="about-left">

                <span class="hero-badge">

                    🌍 About JanVoice

                </span>

                <h1>

                    Empowering
                    <span>Citizens.</span>

                    <br />

                    Transforming
                    <span>Communities.</span>

                </h1>

                <p>

                    JanVoice is a modern civic engagement platform
                    that enables citizens to report civic issues,
                    collaborate with their community and stay informed
                    throughout the resolution process.

                </p>

                <div class="hero-buttons">

                    <a href="ReportIssue.aspx"
                        class="btn-primary">

                        <i class="fa-solid fa-triangle-exclamation"></i>

                        Report Issue

                    </a>

                    <a href="CommunityFeed.aspx"
                        class="btn-primary">

                        <i class="fa-solid fa-users"></i>

                        Community Feed

                    </a>

                </div>

            </div>

            <!-- Right Side -->

            <div class="about-right">

                <img src="Assets/Images/about-hero.png"
                    alt="JanVoice About" />

            </div>

        </div>

    </div>

</section>



    <!--==================================
        OUR VISION
===================================-->

<section class="vision">

    <div class="container">

        <div class="vision-wrapper">

            <!-- Left -->

            <div class="vision-image">

                <img src="Assets/Images/vision.png"
                    alt="Our Vision" />

            </div>

            <!-- Right -->

            <div class="vision-content">

                <span class="section-badge">

                    🌍 Our Vision

                </span>

                <h2>

                    Empowering Every Citizen
                    to Build Better Communities

                </h2>

                <p>

                    Our vision is to create a modern civic platform
                    where every citizen actively participates in
                    improving their neighborhood through transparency,
                    collaboration, and technology.

                </p>

                <div class="vision-points">

                    <div class="point">

                        <i class="fa-solid fa-circle-check"></i>

                        Community Participation

                    </div>

                    <div class="point">

                        <i class="fa-solid fa-circle-check"></i>

                        Transparent Governance

                    </div>

                    <div class="point">

                        <i class="fa-solid fa-circle-check"></i>

                        Smarter Cities

                    </div>

                    <div class="point">

                        <i class="fa-solid fa-circle-check"></i>

                        Better Quality of Life

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


    <!--==================================
        OUR MISSION
===================================-->

<section class="mission">

    <div class="container">

        <div class="section-title">

            <span class="section-badge">

                🚀 Our Mission

            </span>

            <h2>

                Connecting Citizens,
                Communities &
                Local Authorities

            </h2>

            <p>

                JanVoice bridges the gap between citizens and
                government by creating a transparent platform
                where everyone contributes toward solving
                civic problems efficiently.

            </p>

        </div>

        <div class="mission-flow">

            <!-- Step 1 -->

            <div class="mission-card">

                <div class="mission-icon">

                    <i class="fa-solid fa-user"></i>

                </div>

                <h3>Citizen</h3>

                <p>Reports civic issues from anywhere.</p>

            </div>

            <div class="arrow">

                <i class="fa-solid fa-arrow-right"></i>

            </div>

            <!-- Step 2 -->

            <div class="mission-card">

                <div class="mission-icon">

                    <i class="fa-solid fa-mobile-screen-button"></i>

                </div>

                <h3>JanVoice</h3>

                <p>Collects and manages reports securely.</p>

            </div>

            <div class="arrow">

                <i class="fa-solid fa-arrow-right"></i>

            </div>

            <!-- Step 3 -->

            <div class="mission-card">

                <div class="mission-icon">

                    <i class="fa-solid fa-users"></i>

                </div>

                <h3>Community</h3>

                <p>Supports and verifies nearby issues.</p>

            </div>

            <div class="arrow">

                <i class="fa-solid fa-arrow-right"></i>

            </div>

            <!-- Step 4 -->

            <div class="mission-card">

                <div class="mission-icon">

                    <i class="fa-solid fa-user-shield"></i>

                </div>

                <h3>Officer</h3>

                <p>Reviews and updates complaint status.</p>

            </div>

            <div class="arrow">

                <i class="fa-solid fa-arrow-right"></i>

            </div>

            <!-- Step 5 -->

            <div class="mission-card">

                <div class="mission-icon">

                    <i class="fa-solid fa-city"></i>

                </div>

                <h3>Better City</h3>

                <p>Cleaner, safer and smarter communities.</p>

            </div>

        </div>

    </div>

</section>


    <!--==================================
        CORE VALUES
===================================-->

<section class="core-values">

    <div class="container">

        <div class="section-title">

            <span class="section-badge">
                ⭐ Our Core Values
            </span>

            <h2>The Values Behind JanVoice</h2>

            <p>

                Every feature of JanVoice is built around
                these core principles to create a better
                civic experience.

            </p>

        </div>

        <div class="values-grid">

            <!-- Transparency -->

            <div class="value-card">

                <div class="value-icon">

                    <i class="fa-solid fa-eye"></i>

                </div>

                <h3>Transparency</h3>

                <p>

                    Citizens can track complaint progress
                    from submission to resolution.

                </p>

            </div>

            <!-- Collaboration -->

            <div class="value-card">

                <div class="value-icon">

                    <i class="fa-solid fa-handshake"></i>

                </div>

                <h3>Collaboration</h3>

                <p>

                    Communities work together by supporting,
                    verifying and following issues.

                </p>

            </div>

            <!-- Innovation -->

            <div class="value-card">

                <div class="value-icon">

                    <i class="fa-solid fa-lightbulb"></i>

                </div>

                <h3>Innovation</h3>

                <p>

                    Modern technology simplifies civic
                    engagement for everyone.

                </p>

            </div>

            <!-- Accountability -->

            <div class="value-card">

                <div class="value-icon">

                    <i class="fa-solid fa-shield-halved"></i>

                </div>

                <h3>Accountability</h3>

                <p>

                    Every action is recorded to ensure
                    responsible governance.

                </p>

            </div>

        </div>

    </div>

</section>


