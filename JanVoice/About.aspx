                    </li>

                    <li>
                        <i class="fa-solid fa-xmark"></i>
                        No community participation
                    </li>

                    <li>
                        <i class="fa-solid fa-xmark"></i>
                        Difficult tracking
                    </li>

                    <li>
                        <i class="fa-solid fa-xmark"></i>
                        Limited transparency
                    </li>

                    <li>
                        <i class="fa-solid fa-xmark"></i>
                        Slow communication
                    </li>

                </ul>

            </div>

            <!-- VS -->

            <div class="vs-circle">

                VS

            </div>

            <!-- JANVOICE -->

            <div class="comparison-card new-system">

                <h3>

                    JanVoice

                </h3>

                <ul>

                    <li>
                        <i class="fa-solid fa-check"></i>
                        Smart duplicate prevention
                    </li>

                    <li>
                        <i class="fa-solid fa-check"></i>
                        Community collaboration
                    </li>

                    <li>
                        <i class="fa-solid fa-check"></i>
                        Live status tracking
                    </li>

                    <li>
                        <i class="fa-solid fa-check"></i>
                        Interactive issue map
                    </li>

                    <li>
                        <i class="fa-solid fa-check"></i>
                        Complete transparency
                    </li>

                </ul>

            </div>

        </div>

    </div>

</section>


    <!--==================================
        FEATURES OVERVIEW
===================================-->

<section class="features-overview">

    <div class="container">

        <div class="section-title">

            <span class="section-badge">
                🚀 Platform Features
            </span>

            <h2>Everything You Need in One Platform</h2>

            <p>

                JanVoice provides powerful features that make
                civic issue reporting simple, transparent and
                collaborative.

            </p>

        </div>

        <div class="features-grid">

            <div class="feature-box">

                <div class="feature-icon">
                    <i class="fa-solid fa-location-dot"></i>
                </div>

                <h3>Smart Reporting</h3>

                <p>

                    Report issues with precise location,
                    category and photos.

                </p>

            </div>

            <div class="feature-box">

                <div class="feature-icon">
                    <i class="fa-solid fa-users"></i>
                </div>

                <h3>Community Feed</h3>

                <p>

                    Citizens support, verify and
                    follow nearby civic issues.

                </p>

            </div>

            <div class="feature-box">

                <div class="feature-icon">
                    <i class="fa-solid fa-bell"></i>
                </div>

                <h3>Real-Time Notifications</h3>

                <p>

                    Receive updates whenever
                    complaint status changes.

                </p>

            </div>

            <div class="feature-box">

                <div class="feature-icon">
                    <i class="fa-solid fa-map-location-dot"></i>
                </div>

                <h3>Issue Map</h3>

                <p>

                    Explore nearby civic issues
                    on an interactive map.

                </p>

            </div>

            <div class="feature-box">

                <div class="feature-icon">
                    <i class="fa-solid fa-camera"></i>
                </div>

                <h3>Photo Upload</h3>

                <p>

                    Upload multiple photos
                    for better issue verification.

                </p>

            </div>

            <div class="feature-box">

                <div class="feature-icon">
                    <i class="fa-solid fa-chart-line"></i>
                </div>

                <h3>Complete Transparency</h3>

                <p>

                    Track every complaint from
                    submission to resolution.

                </p>

            </div>

        </div>

    </div>

</section>


