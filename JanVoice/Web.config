<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
-->
<configuration>

	<connectionStrings>

		<add name="JanVoiceDB"
			 connectionString="Data Source=ritesh\SQLEXPRESS;
                           Initial Catalog=JanVoiceDB;
                           Integrated Security=True"
			 providerName="System.Data.SqlClient" />

	</connectionStrings>


	<appSettings>

		<!-- Disable ASP.NET Web Forms Unobtrusive Validation -->
		<add key="ValidationSettings:UnobtrusiveValidationMode"
			 value="None" />

	</appSettings>


	<system.web>

		<compilation
			debug="true"
			targetFramework="4.7.2" />

		<httpRuntime
			targetFramework="4.7.2" />

	</system.web>

</configuration>