<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Officer.master.cs" Inherits="JanVoice.MasterPages.Officer" %>

<!DOCTYPE html>

<html>
<head runat="server">

    <title>JanVoice Officer Portal</title>

    <meta charset="utf-8" />

    <meta name="viewport"
        content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet" />

    <!-- Bootstrap Icons -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet" />

    <!-- Google Font -->

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet" />

    <!-- Officer CSS -->
    <link href="../CSS/Officer.css" rel="stylesheet" />


    <asp:ContentPlaceHolder
        ID="head"
        runat="server">
    </asp:ContentPlaceHolder>

</head>

<body>

    <form id="form1" runat="server">

        <div class="wrapper">

            <!-- Sidebar -->

            <aside class="sidebar">

                <div class="logo">

                    <h2>JanVoice

            </h2>

                    <span>Officer Portal

            </span>

                </div>

                <ul class="menu">

                    <li>

                        <a href="../Officer/Dashboard.aspx">

                            <i class="bi bi-grid-fill"></i>

                            Dashboard

                </a>

                    </li>

                    <li>

                        <a href="../Officer/AssignedComplaints.aspx">

                            <i class="bi bi-clipboard-check"></i>

                            Assigned Complaints

                </a>

                    </li>

                    <li>

                        <a href="../Officer/ResolutionDetails.aspx">

                            <i class="bi bi-check2-square"></i>

                            Resolution Details

                </a>

                    </li>

                    <li>

                        <a href="../Officer/TrendingIssues.aspx">

                            <i class="bi bi-graph-up-arrow"></i>

                            Trending Issues

                </a>

                    </li>

                    <li>

                        <a href="../Officer/CommunityLeaderboard.aspx">

                            <i class="bi bi-trophy-fill"></i>

                            Leaderboard

                </a>

                    </li>

                    <li>

                        <a href="../Officer/EmergencyContacts.aspx">

                            <i class="bi bi-telephone-fill"></i>

                            Emergency Contacts

                </a>

                    </li>

                    <li>

                        <a href="../Officer/Feedback.aspx">

                            <i class="bi bi-chat-square-heart-fill"></i>

                            Feedback

                </a>

                    </li>

                </ul>

            </aside>

            <!-- Main Area -->

            <div class="main">

                <!-- Top Navbar -->

                <header class="topbar">

                    <button id="menuBtn" class="menu-btn" type="button">

                        <i class="bi bi-list"></i>

                    </button>

                    <div>

                        <h3>Welcome Officer

                </h3>

                    </div>

                    <div class="top-right">

                        <button class="notify-btn">

                            <i class="bi bi-bell-fill"></i>

                        </button>

                        <div class="profile">

    <asp:Image
        ID="imgOfficer"
        runat="server"
        ImageUrl="~/Images/profile.png"
        CssClass="profile-image" />

    <asp:Label
        ID="lblOfficerName"
        runat="server"
        Text="Officer">
    </asp:Label>

</div>

                        <asp:Button
                            ID="btnLogout"
                            runat="server"
                            Text="Logout"
                            CssClass="logout-btn"
                            OnClick="btnLogout_Click" />

                    </div>

                </header>

                <!-- Content -->

                <main class="content">

                    <asp:ContentPlaceHolder
                        ID="ContentPlaceHolder1"
                        runat="server">
                    </asp:ContentPlaceHolder>

                </main>

            </div>

        </div>

    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


    <script>

        const menuBtn = document.getElementById("menuBtn");

        const sidebar = document.querySelector(".sidebar");

        menuBtn.addEventListener("click", function () {

            sidebar.classList.toggle("active");

        });

    </script>

</body>
</html>
