<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Officer.master.cs" Inherits="JanVoice.MasterPages.Officer" %>

<!DOCTYPE html>

<html>
<head runat="server">

    <meta charset="utf-8" />

    <meta name="viewport"
        content="width=device-width, initial-scale=1" />

    <title>JanVoice | Officer Panel</title>

    <!-- Bootstrap -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet" />

    <!-- Font Awesome -->

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
        rel="stylesheet" />

    <!-- Google Font -->

    <link rel="preconnect"
        href="https://fonts.googleapis.com" />

    <link rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet" />

    <!-- Global CSS -->

    <link href="../CSS/style.css"
        rel="stylesheet" />

    <!-- Officer CSS -->

    <link href="../CSS/officer.css"
        rel="stylesheet" />
    

    <asp:ContentPlaceHolder
        ID="head"
        runat="server">
    </asp:ContentPlaceHolder>

</head>

<body>

    <form id="form1" runat="server">

        <div class="dashboard-wrapper">

            <!-- ======================
        SIDEBAR
====================== -->

            <aside class="sidebar">

                <div class="logo-area">

                    <h3>JanVoice</h3>

                    <p>Officer Panel</p>

                </div>

                <ul class="sidebar-menu">

                    <li>

                        <a href="../Officer/Dashboard.aspx">

                            <i class="fa-solid fa-house"></i>

                            Dashboard

                        </a>

                    </li>

                    <li>

                        <a href="../Officer/AssignedComplaints.aspx">

                            <i class="fa-solid fa-list-check"></i>

                            Assigned Complaints

                        </a>

                    </li>

                    <li>

                        <a href="../Officer/ResolutionDetails.aspx">

                            <i class="fa-solid fa-file-circle-check"></i>

                            Resolution Details

                        </a>

                    </li>

                    <li>

                        <a href="../Officer/TrendingIssues.aspx">

                            <i class="fa-solid fa-arrow-trend-up"></i>

                            Trending Issues

                        </a>

                    </li>

                    <li>

                        <a href="../Officer/CommunityLeaderboard.aspx">

                            <i class="fa-solid fa-trophy"></i>

                            Community Leaderboard

                        </a>

                    </li>

                    <li>

                        <a href="../Officer/EmergencyContact.aspx">

                            <i class="fa-solid fa-phone"></i>

                            Emergency Contacts

                        </a>

                    </li>

                    <li>

                        <a href="../Officer/Feedback.aspx">

                            <i class="fa-solid fa-star"></i>

                            Feedback

                        </a>

                    </li>

                    <li>

                        <a href="../Officer/Profile.aspx">

                            <i class="fa-solid fa-user"></i>

                            Profile

                        </a>

                    </li>
                    <li>

                        <asp:LinkButton
                            ID="btnLogout"
                            runat="server"
                            CssClass="logout-link"
                            style="color:red"
                            OnClick="btnLogout_Click">

<i class="fa-solid fa-right-from-bracket"></i>

Logout

                        </asp:LinkButton>

                    </li>

                </ul>

            </aside>

            <!-- ======================
      MAIN CONTENT
====================== -->

            <div class="main-content">

                <!-- HEADER -->

                <header class="top-header">

                    <div class="header-left">

                        <button
                            type="button"
                            id="menuToggle"
                            class="menu-btn">

                            <i class="fa-solid fa-bars"></i>

                        </button>

                        <h4>Officer Dashboard</h4>

                    </div>

                    <div class="header-right">

                        <div class="notification-icon">

                            <i class="fa-solid fa-bell"></i>

                        </div>

                        <div class="profile-dropdown">

                            <div class="profile-info">
                                <a href="../Officer/Profile.aspx">

                                    <i class="fa-solid fa-user-circle"></i>
                                </a>
                                <span>

                                    <asp:Label
                                        ID="lblOfficerName"
                                        runat="server">
                                    </asp:Label>

                                </span>



                            </div>





                        </div>



                    </div>


                </header>
                <!-- ======================
                     PAGE CONTENT
                ====================== -->

                <main class="page-content">

                    <asp:ContentPlaceHolder
                        ID="ContentPlaceHolder1"
                        runat="server">
                    </asp:ContentPlaceHolder>

                </main>

                <!-- ======================
                         FOOTER
                ====================== -->

                <footer class="footer">
                    © 2026 JanVoice. All Rights Reserved.

                </footer>

            </div>

        </div>

    </form>

    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Officer JS -->

    <script src="../JS/officer.js"></script>




<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


<script>

    const menuBtn = document.getElementById("menuBtn");

    const sidebar = document.querySelector(".sidebar");

    menuBtn.addEventListener("click", function () {

        sidebar.classList.toggle("active");

    });

</script>

</body>
</html>
