<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Citizen.master.cs" Inherits="JanVoice.MasterPages.Citizen" %>

<!DOCTYPE html>

<html>
<head runat="server">

    <meta charset="utf-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1" />

    <title>JanVoice | Citizen Panel</title>

    <!-- Bootstrap -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet" />

    <!-- Font Awesome -->

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
        rel="stylesheet" />

    <!-- Google Font -->

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Global CSS -->

    <link href="../CSS/style.css"
        rel="stylesheet" />

    <!-- Citizen CSS -->

    <link href="../CSS/citizen.css"
        rel="stylesheet" />

    <asp:ContentPlaceHolder
        ID="head"
        runat="server">
    </asp:ContentPlaceHolder>

</head>
<body>
    <form id="form1" runat="server">

        <div class="dashboard-wrapper">

            <!-- Sidebar -->

            <aside class="sidebar">

                <div class="logo-area">

                    <h3>JanVoice</h3>

                    <p>Citizen Panel</p>

                </div>

                <ul class="sidebar-menu">

                    <li>
                        <a href="../Citizen/Dashboard.aspx">
                            <i class="fa-solid fa-house"></i>
                            Dashboard
                        </a>
                    </li>

                    <li>
                        <a href="../Citizen/ReportIssue.aspx">
                            <i class="fa-solid fa-bullhorn"></i>
                            Report Issue
                        </a>
                    </li>

                    <li>
                        <a href="../Citizen/MyComplaints.aspx">
                            <i class="fa-solid fa-list"></i>
                            My Complaints
                        </a>
                    </li>

                    <li>
                        <a href="../Citizen/ComplaintDetails.aspx">
                            <i class="fa-solid fa-file-lines"></i>
                            Complaint Details
                        </a>
                    </li>

                    <li>
                        <a href="../Citizen/Profile.aspx">
                            <i class="fa-solid fa-user"></i>
                            Profile
                        </a>
                    </li>
                    <li>
                        <asp:LinkButton
                            ID="btnLogout"
                            runat="server"
                            CssClass="logout-link"
                            style="color:red"
                            OnClick="btnLogout_Click">

<i class="fa-solid fa-right-from-bracket"></i>

Logout

                        </asp:LinkButton>
                    </li>

                </ul>

            </aside>

            <!-- Main Area -->

            <div class="main-content">

                <!-- Top Header -->

                <header class="top-header">

                    <div class="header-left">

                        <button
                            type="button"
                            id="menuToggle"
                            class="menu-btn">

                            <i class="fa-solid fa-bars"></i>

                        </button>

                        <h4>Citizen Dashboard</h4>

                    </div>

                    <div class="header-right">

                        <!-- Notification -->

                        <div class="notification-icon">
                            <a href="../Citizen/Notifications.aspx">
                                <i class="fa-solid fa-bell"></i>
                            </a>
                        </div>

                        <!-- Profile -->

                        <div class="profile-dropdown">

                            <div class="profile-info">
                                <a href="../Citizen/Profile.aspx">
                                    <i class="fa-solid fa-user-circle"></i>
                                </a>
                                <span>

                                    <asp:Label
                                        ID="lblUserName"
                                        runat="server">
                                    </asp:Label>

                                </span>

                           



                            </div>

                        </div>
                        
                </header>
                <!-- Page Content -->

                <main class="page-content">

                    <asp:ContentPlaceHolder
                        ID="ContentPlaceHolder1"
                        runat="server">
                    </asp:ContentPlaceHolder>

                </main>

                <!-- Footer -->

                <footer class="footer">
                    © 2026 JanVoice. All Rights Reserved.

       
                </footer>

            </div>

        </div>

    </form>

    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Citizen JS -->

    <script src="../JS/citizen.js"></script>

</body>
</html>
